# Copy this file to .env and adjust values. Never commit .env.

# development | staging | production
# The seed command refuses to run when APP_ENV=production.
APP_ENV=development

# Used by docker-compose to create the database and to build the container DATABASE_URL.
POSTGRES_USER=lock
POSTGRES_PASSWORD=lock
POSTGRES_DB=lock

# Host ports exposed on your machine. Change them if they are already in use.
POSTGRES_PORT=5432
API_PORT=8000

# Used when running the backend directly on your machine (without Docker).
# If you change POSTGRES_PORT, update the port here too.
DATABASE_URL=postgresql+asyncpg://lock:lock@localhost:5432/lock
